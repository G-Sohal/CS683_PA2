/*
 * Task 2B (+ Task 3 prefetch awareness)
 * Dynamic I-RRIP for the L2C
 *
 *  task 2b -> set dueling between "instruction prioritisation" and plain RRIP
 *  * NUM_LEADER_SETS (32) of the 1024 L2 sets are LEADER sets. They ALWAYS run plain SRRIP (insert RRPV 2, hit -> RRPV 0, evict any RRPV-3 line).
 *    Leader sets are spread uniformly over the index space: leader  <=>  set % (L2C_SET / NUM_LEADER_SETS) == 0
 *  * For every demand access that reaches a leader set we count instr_acc, instr_miss, total_acc, total_miss
 *  * Every EPOCH_ACCESSES leader accesses we evaluate
 *           ratio=(instr_acc + instr_miss) / (total_acc + total_miss)
 *              ratio > THRESHOLD  => the workload is currently instruction-intensive in the L2, follower sets run I-RRIP (Task 2A policy);
 *              otherwise          => follower sets run plain SRRIP.
 *    After each decision all four counters are halved, so the history decays geometrically and the policy can follow program phases.
 *  * Because the leader sets are never instruction-biased, the counters observe the "natural" instruction pressure of the program, not a pressure that the
 *    policy itself has already reduced
 *
 *  task3 ->prefetch awareness (DYN_IRRIP_PF_AWARE, default ON)
 *  lines brought into the L2 by the L1D SPP prefetcher arrive with type == PREFETCH. With awareness enabled:
 *   insertion: prefetch fill is inserted at RRPV PF_INSERT_RRPV (3=distant) and its per-line "prefetched" bit is set.
 *   promotion: a PREFETCH request that hits in the L2 does NOT promote the line (a prefetch is not a proof of reuse). A demand hit on a prefetched line promotes it to RRPV 0 and clears the bit (the prefetch was useful, the line is now ordinary).
 *   eviction: among RRPV-3 lines we evict, in order: an unused prefetched line, a data line, an instruction line (follower sets in I-RRIP mode) / any line (RRIP mode).
 *   dueling: prefetch requests are not counted in the leader-set counters, so aggressive prefetching cannot make the workload look "data-intensive" and switch off instruction protection.
 *  without an L1D/L2 prefetcher no PREFETCH packets reach the L2, so the Task 2B results are identical with or without this awareness.
 */

#include "cache.h"
#include <cstdlib>

#define maxRRPV 3
#define RRPV_INSERT_DATA (maxRRPV - 1)
#define RRPV_INSERT_INSTR 0
#define RRPV_HIT 0

#define NUM_LEADER_SETS 32
#define LEADER_STRIDE (L2C_SET / NUM_LEADER_SETS)
#define EPOCH_ACCESSES 1024
#define DEFAULT_THRESHOLD 0.50

static uint32_t l2_rrpv[L2C_SET][L2C_WAY];
static uint8_t  l2_is_instr[L2C_SET][L2C_WAY];  //line was brought/touched by an instruction fetch
static uint8_t  l2_is_pf[L2C_SET][L2C_WAY]; //line was brought by a prefetch and not yet used

//set-dueling monitor(counters for the leader sets)
static uint32_t ctr_instr_acc=0, ctr_instr_miss=0, ctr_total_acc=0, ctr_total_miss=0;
static uint32_t epoch_accesses=0;
static bool irrip_mode=true; //follower-set policy

//configuration
static double dyn_threshold =DEFAULT_THRESHOLD;
static bool pf_aware=true;
static uint32_t pf_insert_rrpv=maxRRPV;

//statistics only
static uint64_t stat_epochs=0, stat_epochs_irrip=0, stat_switches=0;
static uint64_t stat_follower_irrip_fills=0, stat_follower_rrip_fills=0;
static uint64_t stat_pf_fills=0, stat_pf_used=0, stat_pf_evicted_unused=0;
static double   stat_ratio_sum=0, stat_ratio_min=1, stat_ratio_max=0;

static inline bool is_leader(uint32_t set) { return (set % LEADER_STRIDE) == 0; }

//initialize replacement state
void CACHE::l2c_initialize_replacement(){
    if(const char *s=getenv("DYN_IRRIP_THRESHOLD")) dyn_threshold=atof(s);
    if(const char *s=getenv("DYN_IRRIP_PF_AWARE"))  pf_aware=atoi(s) != 0;
    if(const char *s=getenv("DYN_IRRIP_PF_INSERT")) pf_insert_rrpv=(uint32_t)atoi(s) > maxRRPV ? maxRRPV : (uint32_t)atoi(s);

    cout <<"Initialize Dynamic I-RRIP state for L2C: leader sets " << NUM_LEADER_SETS<< " threshold " << dyn_threshold << " prefetch-aware " << pf_aware<< " pf-insert-rrpv " << pf_insert_rrpv << endl;
    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j]=maxRRPV;
            l2_is_instr[i][j]=0;
            l2_is_pf[i][j]=0;
        }
    }
}

//find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type){
    for (int i=0; i<L2C_WAY; i++)
        if (!current_set[i].valid)
            return i;

    bool use_irrip=!is_leader(set) && irrip_mode;
    while (1){
        //(Task 3) unused prefetched lines are the cheapest victims
        if (pf_aware)
            for (int i=0; i<L2C_WAY; i++)
                if (l2_rrpv[set][i] == maxRRPV && l2_is_pf[set][i]) {
                    stat_pf_evicted_unused++;
                    return i;
                }

        //(Task 2)in I-RRIP mode protect instruction lines: data first
        if (use_irrip)
            for (int i=0; i<L2C_WAY; i++)
                if (l2_rrpv[set][i] == maxRRPV && !l2_is_instr[set][i])
                    return i;

        for(int i=0; i<L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                return i;

        for(int i=0; i<L2C_WAY; i++) l2_rrpv[set][i]++;
    }
    assert(0);
    return 0;
}

//set-dueling monitor called for every access to a leader set
static void dyn_irrip_monitor(uint32_t type, uint8_t hit, uint8_t isInstruction){
    if (type == WRITEBACK) return;
    if (pf_aware && type == PREFETCH) return;

    ctr_total_acc++;
    if(!hit) ctr_total_miss++;
    if(isInstruction) {
        ctr_instr_acc++;
        if (!hit) ctr_instr_miss++;
    }

    if(++epoch_accesses < EPOCH_ACCESSES) return;

    //end of epoch decide the follower policy
    double ratio=(double)(ctr_instr_acc + ctr_instr_miss) / (double)(ctr_total_acc + ctr_total_miss);
    bool new_mode=ratio > dyn_threshold;
    stat_ratio_sum += ratio;
    if(ratio < stat_ratio_min) stat_ratio_min=ratio;
    if(ratio > stat_ratio_max) stat_ratio_max=ratio;
    if(new_mode != irrip_mode) stat_switches++;
    irrip_mode=new_mode;
    stat_epochs++;
    if(irrip_mode) stat_epochs_irrip++;
    ctr_instr_acc >>= 1; ctr_instr_miss >>= 1; ctr_total_acc >>= 1; ctr_total_miss >>= 1;
    epoch_accesses=0;
}

//called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip) assert(0);

    bool leader=is_leader(set);
    if(leader) dyn_irrip_monitor(type, hit, isInstruction);

    bool use_irrip=!leader && irrip_mode;

    if(hit){
        if (type == WRITEBACK) return;    //writeback is not reuse
        if(pf_aware && type == PREFETCH) return; //neither is a prefetch(task3)

        //demand hit is promote =prefetched line that is demanded becomes ordinary
        if (l2_is_pf[set][way]) { stat_pf_used++; l2_is_pf[set][way]=0; }
        l2_rrpv[set][way]=RRPV_HIT;
        if (isInstruction) l2_is_instr[set][way]=1;
        return;
    }

    //insertion
    l2_is_instr[set][way]=isInstruction ? 1 : 0;
    l2_is_pf[set][way] =0;

    if (pf_aware && type== PREFETCH) {
        l2_rrpv[set][way] =pf_insert_rrpv;
        l2_is_pf[set][way]=1;
        stat_pf_fills++;
        return;
    }

    if(use_irrip) {
        l2_rrpv[set][way]=isInstruction ? RRPV_INSERT_INSTR : RRPV_INSERT_DATA;
        stat_follower_irrip_fills++;
    } 
    else {
        l2_rrpv[set][way]=RRPV_INSERT_DATA;
        if (!leader) stat_follower_rrip_fills++;
    }
}

//use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
    cout << "DYN-IRRIP threshold: " << dyn_threshold << " pf_aware: " << pf_aware<< " pf_insert_rrpv: " << pf_insert_rrpv << endl;
    cout << "DYN-IRRIP epochs: " << stat_epochs << " epochs_in_irrip_mode: " << stat_epochs_irrip<< " switches: " << stat_switches << " final_mode: " << (irrip_mode ? "I-RRIP" : "RRIP") << endl;
    cout << "DYN-IRRIP ratio mean: " << (stat_epochs ? stat_ratio_sum / stat_epochs : 0)<< " min: " << stat_ratio_min << " max: " << stat_ratio_max << endl;
    cout << "DYN-IRRIP follower fills irrip: " << stat_follower_irrip_fills<< " rrip: " << stat_follower_rrip_fills << endl;
    cout << "DYN-IRRIP prefetch fills: " << stat_pf_fills << " used: " << stat_pf_used << " evicted_unused: " << stat_pf_evicted_unused << endl;
}
