#include "cache.h"

#define maxRRPV 3
#define LEADER_SET_INTERVAL 32 // 1024 / 32 = 32 leader sets (3.125% of total sets)

#ifndef DYN_THRESHOLD
#define DYN_THRESHOLD 0.25
#endif

uint32_t l2_rrpv[L2C_SET][L2C_WAY];

// Statistics tracked on leader sets (which run pure RRIP)
uint64_t leader_instr_access = 0;
uint64_t leader_instr_miss = 0;
uint64_t leader_total_access = 0;
uint64_t leader_total_miss = 0;

// Helper to determine if a set is a leader set
inline bool is_leader_set(uint32_t set)
{
    return (set % LEADER_SET_INTERVAL == 0);
}

//return true if irrip should be used
inline bool use_irrip(uint32_t set)
{
    if (is_leader_set(set)) return false;
    uint64_t total = leader_total_access + leader_total_miss;
    if (total == 0) return true;
    uint64_t instr = leader_instr_access + leader_instr_miss;
    double ratio = (double)instr / (double)total;

    return (ratio > DYN_THRESHOLD);
}

// Initialize replacement state for Dynamic I-RRIP
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize Dynamic I-RRIP state for L2C (Threshold = " << DYN_THRESHOLD << ")" << endl;

    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
        }
    }

    leader_instr_access = 0;
    leader_instr_miss = 0;
    leader_total_access = 0;
    leader_total_miss = 0;
}

// Find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // 1. Look for an invalid line first
    for (int i=0; i<L2C_WAY; i++) {
        if (!current_set[i].valid)
            return i;
    }

    // 2. If in I-RRIP mode, prioritize evicting non-instruction lines
    if (use_irrip(set)) {
        while (1)
        {
            // First pass: try to find a non-instruction victim at maxRRPV
            for (int i=0; i<L2C_WAY; i++) {
                if (!current_set[i].instruction && l2_rrpv[set][i] >= maxRRPV)
                    return i;
            }

            // Check if there are ANY non-instruction lines in this set
            bool has_non_instr = false;
            for (int i=0; i<L2C_WAY; i++) {
                if (!current_set[i].instruction) {
                    has_non_instr = true;
                    break;
                }
            }

            // If there are NO non-instruction lines, evict an instruction line at maxRRPV
            if (!has_non_instr) {
                for (int i=0; i<L2C_WAY; i++) {
                    if (l2_rrpv[set][i] >= maxRRPV)
                        return i;
                }
            }

            // Aging: increment RRPV of lines that haven't reached maxRRPV
            for (int i=0; i<L2C_WAY; i++) {
                if (l2_rrpv[set][i] < maxRRPV)
                    l2_rrpv[set][i]++;
            }
        }
    } else {
        // Standard RRIP victim selection
        while (1)
        {
            for (int i=0; i<L2C_WAY; i++) {
                if (l2_rrpv[set][i] >= maxRRPV)
                    return i;
            }

            for (int i=0; i<L2C_WAY; i++) {
                if (l2_rrpv[set][i] < maxRRPV)
                    l2_rrpv[set][i]++;
            }
        }
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// Called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    // Update leader set statistics for Set-Dueling
    if (is_leader_set(set)) {
        leader_total_access++;
        if (!hit)
            leader_total_miss++;

        if (isInstruction) {
            leader_instr_access++;
            if (!hit)
                leader_instr_miss++;
        }

        // Periodic decay to avoid saturation and adapt to dynamic phase transitions
        if (leader_total_access >= 4096) {
            leader_instr_access >>= 1;
            leader_instr_miss >>= 1;
            leader_total_access >>= 1;
            leader_total_miss >>= 1;
        }
    }

    if (hit) {
        // Cache hit promotes line to MRU (0)
        l2_rrpv[set][way] = 0;
    } else {
        // Insertion:
        if (use_irrip(set)) {
            // I-RRIP mode: prioritize instructions with intermediate RRPV
            if (isInstruction)
                l2_rrpv[set][way] = 1;
            else
                l2_rrpv[set][way] = maxRRPV - 1; // 2
        } else {
            // Standard RRIP mode: insert all lines with RRPV = 2
            l2_rrpv[set][way] = maxRRPV - 1; // 2
        }
    }
}

void CACHE::l2c_replacement_final_stats()
{
}
